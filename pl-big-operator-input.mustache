{{#question}}
  {{#inline}}
    <span
      class="pl-big-operator-input pl-big-operator-input--inline flex-nowrap"
      role="group"
      aria-label="Big operator input"
      style="--pl-big-operator-input-body-size: {{ body_size }}ch; --pl-big-operator-input-index-field-size: {{ index_field_size }}ch"
    >
      {{> question-content }}
    </span>
    {{#display_feedback}}
      <span class="alert alert-info d-inline-block mt-2 mb-0 pl-big-operator-input-feedback" role="status">
        {{{ feedback }}}
      </span>
    {{/display_feedback}}
  {{/inline}}
  {{#block}}
    <div
      class="pl-big-operator-input pl-big-operator-input--block flex-nowrap"
      role="group"
      aria-label="Big operator input"
      style="--pl-big-operator-input-body-size: {{ body_size }}ch; --pl-big-operator-input-index-field-size: {{ index_field_size }}ch"
    >
      {{> question-content }}
    </div>
    {{#display_feedback}}
      <div class="alert alert-info mt-2 mb-0 pl-big-operator-input-feedback" role="status">
        {{{ feedback }}}
      </div>
    {{/display_feedback}}
  {{/block}}
{{/question}}
{{#submission}}
  {{#inline}}
    <span
      class="pl-big-operator-input pl-big-operator-input--inline pl-big-operator-input__submission"
    >
      {{> submission-content }}
    </span>
  {{/inline}}
  {{#block}}
    <div
      class="pl-big-operator-input pl-big-operator-input--block pl-big-operator-input__submission"
    >
      {{> submission-content }}
    </div>
  {{/block}}
{{/submission}}
