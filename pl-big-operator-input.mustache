{{#question}}
  {{#inline}}
    <span
      class="pl-big-operator-input pl-big-operator-input--inline flex-nowrap"
      role="group"
      aria-label="Big operator input"
      style="--pl-big-operator-input-body-size: {{ body_size_css }}; --pl-big-operator-input-index-field-size: {{ index_field_size }}ch"
    >
      <span class="pl-big-operator-input__content">
        {{> question-content }}
      </span>
    </span>
  {{/inline}}
  {{#block}}
    <div
      class="pl-big-operator-input pl-big-operator-input--block flex-nowrap{{#body_fill}} pl-big-operator-input--body-fill{{/body_fill}}"
      role="group"
      aria-label="Big operator input"
      style="--pl-big-operator-input-body-size: {{ body_size_css }}; --pl-big-operator-input-index-field-size: {{ index_field_size }}ch"
    >
      <span class="pl-big-operator-input__content">
        {{> question-content }}
      </span>
    </div>
  {{/block}}
{{/question}}
{{#submission}}
  {{#inline}}
    <span
      class="pl-big-operator-input pl-big-operator-input--inline pl-big-operator-input__submission"
    >
      <span class="pl-big-operator-input__content">
        {{> submission-content }}
      </span>
    </span>
  {{/inline}}
  {{#block}}
    <div
      class="pl-big-operator-input pl-big-operator-input--block pl-big-operator-input__submission"
    >
      <span class="pl-big-operator-input__content">
        {{> submission-content }}
      </span>
    </div>
  {{/block}}
{{/submission}}
