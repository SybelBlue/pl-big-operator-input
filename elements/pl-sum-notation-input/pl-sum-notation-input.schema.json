{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "properties": {
    "answers-name": {},
    "end-answer": {},
    "grading-scheme": {
      "enum": [
        "strict",
        "generous",
        "exact",
        "piecewise"
      ]
    },
    "index-variable": {},
    "integral": {
      "enum": ["true", "false"]
    },
    "summand-relative-weight": {
      "default": 3,
      "type": "integer"
    },
    "start-answer": {},
    "summand-answer": {},
    "weight": {
      "default": 1,
      "type": "integer"
    },
    "variables": {}
  },
  "required": [
    "answers-name",
    "end-answer",
    "index-variable",
    "start-answer",
    "summand-answer"
  ]
}
