{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "properties": {
    "answers-name": {
      "type": "string"
    },
    "operator": {
      "default": "sum",
      "enum": [
        "sum",
        "product",
        "integral",
        "limit",
        "union",
        "intersection",
        "disjoint-union",
        "and",
        "or",
        "min",
        "max",
        "custom"
      ]
    },
    "operator-latex": {
      "type": "string"
    },
    "limits": {
      "default": "auto",
      "enum": [
        "auto",
        "bounds",
        "domain",
        "approach"
      ]
    },
    "index-variable": {
      "type": "string"
    },
    "variables": {
      "type": "string"
    },
    "limit-direction": {
      "default": "two-sided",
      "enum": [
        "two-sided",
        "from-left",
        "from-right"
      ]
    },
    "allow-blank": {
      "default": "false",
      "enum": ["true", "false"]
    },
    "grading-method": {
      "default": "equivalent",
      "enum": [
        "exact",
        "component",
        "equivalent"
      ]
    },
    "body-relative-weight": {
      "default": 3,
      "minimum": 1,
      "type": "integer"
    },
    "weight": {
      "default": 1,
      "type": "integer"
    },
    "correct-answer": {},
    "correct-answer-start": {
      "type": "string"
    },
    "correct-answer-end": {
      "type": "string"
    },
    "correct-answer-domain": {
      "type": "string"
    },
    "correct-answer-target": {
      "type": "string"
    },
    "correct-answer-body": {
      "type": "string"
    }
  },
  "required": [
    "answers-name",
    "index-variable"
  ],
  "oneOf": [
    {
      "properties": {
        "operator": {
          "const": "custom"
        },
        "limits": {
          "enum": ["bounds", "domain"]
        }
      },
      "required": ["operator", "operator-latex", "limits"]
    },
    {
      "properties": {
        "operator": {
          "enum": [
            "sum",
            "product",
            "integral",
            "union",
            "intersection",
            "disjoint-union",
            "and",
            "or",
            "min",
            "max"
          ]
        },
        "limits": {
          "enum": ["auto", "bounds", "domain"]
        }
      },
      "not": {
        "required": ["operator-latex"]
      }
    },
    {
      "properties": {
        "operator": {
          "const": "limit"
        },
        "limits": {
          "enum": ["auto", "approach"]
        }
      },
      "required": ["operator"],
      "not": {
        "required": ["operator-latex"]
      }
    }
  ]
}
