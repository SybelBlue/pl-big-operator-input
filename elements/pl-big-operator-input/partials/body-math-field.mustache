{{! htmlmustache-disable pl-prefer-pl-inputs }}
<span class="input-group pl-big-operator-input__math-field w-100">
  <script>
    $(function () {
      window.PLBigOperatorInput("{{ answers_name }}");
    });
  </script>
  <input
    name="{{ answers_name }}"
    id="big-operator-input-sub-{{ answers_name }}"
    type="hidden"
    value=""
  />
  <input
    name="{{ answers_name }}-latex"
    id="big-operator-input-latex-{{ answers_name }}"
    type="hidden"
    value="{{ raw_submitted_answer_latex }}"
  />
  <math-field
    id="big-operator-input-{{ answers_name }}"
    class="form-control pl-big-operator-input__math-field-input{{#parse_error}} has-validation is-invalid no-validation-icon{{/parse_error}}"
    style="min-width: {{ size }}ch"
    {{#parse_error}}aria-invalid="true"{{/parse_error}}
    {{#parse_error}}aria-describedby="{{ error_id }}"{{/parse_error}}
    {{^editable}}contenteditable="false"{{/editable}}
    data-placeholder-text=""
    custom-functions="{{ custom_functions }}"
    allow-trig="allow-trig"
    {{#label}}aria-label="{{ label }}"{{/label}}
  ></math-field>
  {{#parse_error}}
    <span id="{{ error_id }}" class="invalid-feedback d-block" role="alert">{{ parse_error }}</span>
  {{/parse_error}}
</span>
