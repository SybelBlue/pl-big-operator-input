<div class="pl-big-operator-input flex-nowrap" aria-label="Big operator expression input">
  {{#integral}}
    <div
      class="pl-big-operator-input__operator-stack pl-big-operator-input__operator-stack--integral"
    >
      <div class="pl-big-operator-input__operator" aria-hidden="true">
        \(\displaystyle {{{ operator_latex }}}\)
      </div>
      <div class="pl-big-operator-input__limits">
        {{#bounds}}
          <div class="pl-big-operator-input__lower">
            {{#lower_field}}{{> bounds-math-field }}{{/lower_field}}
          </div>
          <div class="pl-big-operator-input__upper">
            {{#upper_field}}{{> bounds-math-field }}{{/upper_field}}
          </div>
        {{/bounds}}
        {{#domain}}
          <div class="pl-big-operator-input__domain-spacer" aria-hidden="true">
          </div>
          <div class="pl-big-operator-input__lower pl-big-operator-input__annotation">
            {{#annotation_field}}{{> bounds-math-field }}{{/annotation_field}}
          </div>
        {{/domain}}
      </div>
    </div>
  {{/integral}}
  {{^integral}}
    <div
      class="pl-big-operator-input__operator-stack{{#domain}} pl-big-operator-input__operator-stack--annotated{{/domain}}{{#approach}} pl-big-operator-input__operator-stack--annotated{{/approach}}"
    >
      {{#bounds}}
        <div class="pl-big-operator-input__upper">
          {{#upper_field}}{{> bounds-math-field }}{{/upper_field}}
        </div>
      {{/bounds}}
      <div class="pl-big-operator-input__operator" aria-hidden="true">
        \(\displaystyle {{{ operator_latex }}}\)
      </div>
      {{#bounds}}
        <div class="pl-big-operator-input__lower">
          {{#lower_field}}{{> bounds-math-field }}{{/lower_field}}
        </div>
      {{/bounds}}
      {{#domain}}
        <div class="pl-big-operator-input__annotation">
          {{#annotation_field}}{{> bounds-math-field }}{{/annotation_field}}
        </div>
      {{/domain}}
      {{#approach}}
        <div class="pl-big-operator-input__annotation">
          {{#annotation_field}}{{> bounds-math-field }}{{/annotation_field}}
        </div>
      {{/approach}}
    </div>
  {{/integral}}
  {{#body_field}}
    <div class="pl-big-operator-input__body">
      <span class="visually-hidden">{{ label }}</span>{{> body-math-field }}
    </div>
  {{/body_field}}
  {{#integral}}
    <span class="pl-big-operator-input__differential">\(\mathrm d {{{ index_label }}}\)</span>
  {{/integral}}
</div>
